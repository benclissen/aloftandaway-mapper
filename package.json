{
  "name": "mapper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "mapper": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.node.json && vite build",
    "test": "vitest run --project unit",
    "test:e2e": "npm run build && vitest run --project e2e",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.bench.json && tsc -p tsconfig.studio.json",
    "bench:render": "tsx bench/render-speed.ts",
    "bench:pipeline": "npm run build && tsx bench/pipeline.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "maplibre-gl": "^6.14.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
